import numpy as np

from rag.embeddings import (
    create_embedding
)

from rag.vector_store import (
    load_index
)


def retrieve_context(
    question,
    top_k=3
):

    index, chunks = load_index()

    if index is None:
        return ""

    query_embedding = create_embedding(
        question
    )

    distances, indices = index.search(
        np.array(
            [query_embedding]
        ).astype("float32"),
        top_k
    )

    context = []

    for idx in indices[0]:

        if idx < len(chunks):

            context.append(
                chunks[idx]
            )

    return "\n\n".join(
        context
    )